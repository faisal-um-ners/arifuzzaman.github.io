---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }} Research Articles</title>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/articles/' | absolute_url }}"/>
  <id>{{ '/articles/' | absolute_url }}</id>
  <updated>{% assign newest = site.articles | sort: "date" | last %}{{ newest.date | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% assign sorted_articles = site.articles | sort: "date" | reverse %}
  {% for article in sorted_articles limit:20 %}
  <entry>
    <title>{{ article.title | xml_escape }}</title>
    <link href="{{ article.url | absolute_url }}"/>
    <id>{{ article.url | absolute_url }}</id>
    <updated>{{ article.date | date_to_xmlschema }}</updated>
    <summary>{{ article.summary | xml_escape }}</summary>
    <category term="{{ article.category | xml_escape }}"/>
  </entry>
  {% endfor %}
</feed>
